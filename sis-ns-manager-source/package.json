{
  "name": "sis-ns-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development concurrently -n back,front -c blue,green \"npm run dev-back\" \"npm run dev-front\"",
    "dev-front": "vite",
    "dev-back": "tsx watch backend/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node --experimental-strip-types backend/index.ts",
    "lint": "eslint './**/*.{ts,tsx}'",
    "preview": "vite preview"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "@tanstack/react-query": "5.101.0",
    "axios": "^1.15.0",
    "connect-redis": "^8.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "ioredis": "^5.10.0",
    "openid-client": "^5.7.1",
    "passport": "^0.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sequelize": "6.37.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/express-session": "1.19.0",
    "@types/node": "24.12.4",
    "@types/passport": "1.0.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prettier": "3.8.1",
    "tsx": "4.22.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
